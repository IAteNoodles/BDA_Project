# Job Market Forecasting - Environment Configuration
# Copy to .env and adjust values for your environment

# ==================== Hadoop Configuration ====================
HADOOP_NAMENODE_URI=hdfs://namenode:9000
HADOOP_NAMENODE_HTTP_PORT=9870
HADOOP_DATANODE_PORT=50075
HADOOP_YARN_RESOURCEMANAGER=yarn-rm:8032
HDFS_REPLICATION_FACTOR=1

# ==================== Spark Configuration ====================
SPARK_MASTER=spark://spark-master:7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2
SPARK_DEFAULT_PARALLELISM=200
SPARK_SQL_SHUFFLE_PARTITIONS=200

# ==================== Kafka Configuration ====================
KAFKA_BROKERS=kafka:9092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_PARTITIONS=4
KAFKA_REPLICATION_FACTOR=1
KAFKA_LOG_RETENTION_DAYS=7
KAFKA_COMPRESSION_TYPE=snappy

# ==================== HBase Configuration ====================
HBASE_HOST=hbase
HBASE_ZOOKEEPER_PORT=2181
HBASE_MASTER_PORT=16000
HBASE_REGIONSERVER_PORT=16020
HBASE_REST_PORT=20550

# ==================== PostgreSQL Configuration ====================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=job_market
DB_USER=postgres
DB_PASSWORD=postgres123
DB_POOL_SIZE=10
DB_POOL_MAX_IDLE_TIME=900
DB_CONNECTION_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# ==================== Redis Configuration ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_TTL=3600
REDIS_MAX_MEMORY=2gb
REDIS_EVICTION_POLICY=allkeys-lru

# ==================== API Server Configuration ====================
API_PORT=8080
API_WORKERS=4
API_THREAD_POOL_SIZE=10
API_THREAD_QUEUE_SIZE=100

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ==================== Frontend Configuration ====================
REACT_APP_API_URL=http://localhost:8080
REACT_APP_ENV=development
REACT_APP_LOG_LEVEL=debug
REACT_APP_ENABLE_ANALYTICS=false

# ==================== Airflow Configuration ====================
AIRFLOW_HOME=/airflow
AIRFLOW__CORE__DAGS_FOLDER=/airflow/dags
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql://postgres:postgres123@postgres:5432/airflow
AIRFLOW__WEBSERVER__AUTHENTICATE=false
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW_VAR_HDFS_NAMENODE_URI=hdfs://namenode:9000
AIRFLOW_VAR_SPARK_MASTER=spark://spark-master:7077

# ==================== Data Pipeline Configuration ====================
DATA_PIPELINE_SCHEDULE=daily
DATA_PIPELINE_START_TIME=02:00
BATCH_SIZE=10000
ETL_TIMEOUT_MINUTES=30

# ==================== Feature Flags ====================
ENABLE_STREAMING_PROCESSING=true
ENABLE_ML_FORECASTING=true
ENABLE_REAL_TIME_DASHBOARDS=true
ENABLE_DATA_EXPORT=true
ENABLE_ADVANCED_ANALYTICS=true

# ==================== Logging Configuration ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ==================== Monitoring & Metrics ====================
METRICS_ENABLED=true
METRICS_INTERVAL_SECONDS=60
TRACES_ENABLED=false

# ==================== Security ====================
ENABLE_SSL=false
SSL_CERT_PATH=/etc/certs/cert.pem
SSL_KEY_PATH=/etc/certs/key.pem
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# ==================== External Services (Optional) ====================
# Job Board APIs
INDEED_API_KEY=
LINKEDIN_API_KEY=
GLASSDOOR_API_KEY=

# Cloud Storage (for backups)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=job-market-backups

# ==================== Email Notifications ====================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=admin@example.com

# ==================== Debug/Development ====================
DEBUG=false
DEVELOPMENT_MODE=true
ENABLE_PROFILING=false
MOCK_DATA_ENABLED=false
